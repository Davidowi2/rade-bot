# Copy to .env and fill in. Never commit .env.

# --- Bybit (live keys — keep safe) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# --- Tradelocker (demo first) ---
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=PLEXY
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ENV=demo

# --- Telegram ingestion ---
TELEGRAM_CHANNEL=@replace_me
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Hosted deployments only: a StringSession, produced by
#   python scripts/export_telegram_session.py
# It is a credential. Leave empty locally to use the rade_session file.
TELEGRAM_SESSION=

# --- BotFather notifications (separate from the user session above) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# --- Supabase (backend only; never put the service-role key in the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mirror service ---
# Bearer token for /api/*. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
MIRROR_API_TOKEN=
# Paper account equity and contract size. Both are required; neither is guessed.
MIRROR_EQUITY=
MIRROR_CONTRACT_UNITS_PER_LOT=100
MIRROR_QUOTE_PROVIDER=none          # none | tradelocker
MIRROR_QUOTE_MAX_AGE_S=2
MIRROR_RUN_LISTENER=0               # 1 to run the listener beside the API
MIRROR_RECONNECT_S=900
MIRROR_SQLITE_PATH=./data/observer_intents.sqlite
MIRROR_STATE=./data/mirror_state.json
MIRROR_HEARTBEAT=./data/mirror_listener.heartbeat.json

# --- Vercel dashboard (set these in Vercel, not here) ---
# DASHBOARD_TOKEN=      the token the browser asks for
# MIRROR_API_URL=       https://<render-service>.onrender.com
# MIRROR_API_TOKEN=     same value as above

# --- Runtime ---
RADE_ENV=paper            # paper | demo | live
RADE_LOG_LEVEL=INFO
RADE_DATA_DIR=./data
