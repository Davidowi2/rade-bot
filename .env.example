# Copy to .env and fill in. Never commit .env.

# --- Bybit (live keys — keep safe) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# --- Tradelocker (demo first) ---
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=PLEXY
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ENV=demo

# --- Telegram ingestion ---
TELEGRAM_CHANNEL=@replace_me
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Runtime ---
RADE_ENV=paper            # paper | demo | live
RADE_LOG_LEVEL=INFO
RADE_DATA_DIR=./data
EOF