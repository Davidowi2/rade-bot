# Copy to .env and fill in. Never commit .env.

# --- Bybit (live keys — keep safe) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# --- Tradelocker: the approved destination account ---
# BLBRY is the approved account. The credentials below are what the gateway
# logs in with; MIRROR_DESTINATION_* is what it must resolve to, and a
# mismatch is refused before any order.
#
# On Render these values already exist and are NOT read from this file:
# `scripts/update_render_env.py` reads the remote set, applies only the
# settings it declares, and writes the union back, so a stale local copy here
# cannot retarget or overwrite the deployed destination.
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=BLBRY
TRADELOCKER_ACCOUNT_ID=2346225
TRADELOCKER_ENV=demo               # the account lives on the demo host

# Approved destination. Never unset: an executor with no pin does not start.
MIRROR_DESTINATION_SERVER=BLBRY
MIRROR_DESTINATION_ACCOUNT_ID=2346225

# --- mirror execution rule ---
# 0 = paper only (record intents, place no orders). 1 = place real orders.
MIRROR_EXECUTE=0
MIRROR_FIXED_LOTS=0.02
MIRROR_MAX_TRADE_RISK_USD=25
# The broker's contract size for XAUUSD on BLBRY, read from the broker's own
# instrument specification 2026-11-15 (lotSize 100, lotStep 0.01, max 40).
# CONFIRMED=1 is what lets a signal be sized at all; while it is 0 every
# market call is refused before any size is computed.
MIRROR_CONTRACT_UNITS_PER_LOT=100
MIRROR_CONTRACT_UNITS_CONFIRMED=1
# Paper equity, required once the contract size is confirmed and no executor
# is running. With an executor the equity is read from the broker instead.
MIRROR_EQUITY=4862.73

# --- pre-trade risk controls ------------------------------------------
# A value of 0 switches that control OFF, and the startup report says so.
MIRROR_MAX_OPEN_POSITIONS=1
MIRROR_DAILY_LOSS_FRACTION=0.01     # of the day's opening equity
MIRROR_MAX_DRAWDOWN_FRACTION=0.0335 # of peak equity; the challenge floor is 6%
MIRROR_MAX_SPREAD=1.0               # price units; the broker quotes 0.31
MIRROR_MAX_SLIPPAGE=2.0             # price units from the published entry
MIRROR_DUPLICATE_WINDOW_S=900       # identical text inside this is copied once

# --- Telegram ingestion ---
TELEGRAM_CHANNEL=@replace_me
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Hosted deployments only: a StringSession, produced by
#   python scripts/export_telegram_session.py
# It is a credential. Leave empty locally to use the rade_session file.
TELEGRAM_SESSION=

# --- BotFather notifications (separate from the user session above) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# --- Supabase (backend only; never put the service-role key in the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mirror service ---
# Bearer token for /api/*. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
MIRROR_API_TOKEN=
# Paper equity. Required only once the contract size is confirmed and no
# executor is running; with an executor the equity is the broker's.
MIRROR_EQUITY=
MIRROR_QUOTE_PROVIDER=none          # none | tradelocker
MIRROR_QUOTE_MAX_AGE_S=2
MIRROR_RUN_LISTENER=0               # 1 to run the listener beside the API
MIRROR_RECONNECT_S=900
# Where the very first activation starts. "latest" imports nothing that is
# already in the channel; a message id imports from there; "history" imports
# everything and additionally needs MIRROR_ALLOW_HISTORY_IMPORT=1.
MIRROR_START_AT=latest
MIRROR_ALLOW_HISTORY_IMPORT=0
# How often failed notifications are retried, and how old a listener heartbeat
# may be before the service reports itself unhealthy.
MIRROR_NOTIFY_RETRY_S=300
MIRROR_HEALTH_MAX_AGE_S=90
MIRROR_SQLITE_PATH=./data/observer_intents.sqlite
MIRROR_STATE=./data/mirror_state.json
MIRROR_HEARTBEAT=./data/mirror_listener.heartbeat.json
# Set to 1 on a host whose disk is wiped on every restart. Render sets RENDER
# itself; the service then refuses to start without Supabase.
MIRROR_REQUIRE_DURABLE_STORE=0

# --- execution path ---------------------------------------------------
# MIRROR_EXECUTE=1 places real orders on the destination account. The gateway
# refuses any environment but demo and refuses a demo name pointed at another
# host; the destination pin refuses any other account.
# How often open trades are managed (one ladder step per pass), and how long
# an accepted order may go without a position before the trade goes to review.
MIRROR_MANAGE_EVERY_S=5
MIRROR_FILL_TIMEOUT_S=300

# --- Vercel dashboard (set these in Vercel, not here) ---
# Sign-in. DASHBOARD_PASSWORD_HASH is salted SHA-256, never the clear password:
#   salt=$(printf %s "$DASHBOARD_EMAIL" | sha256sum | cut -c1-16)
#   node -e 'const c=require("crypto"),s=process.argv[1],p=process.argv[2];
#     let d=c.createHash("sha256").update(s+":"+p).digest("hex");
#     for(let i=0;i<20000;i++) d=c.createHash("sha256").update(d).digest("hex");
#     console.log(d)' "$salt" "the new password"
# DASHBOARD_EMAIL=
# DASHBOARD_PASSWORD_HASH=
# DASHBOARD_SESSION_SECRET=   random 32 bytes, base64url
# DASHBOARD_TOKEN=            optional backstop for scripted access
# MIRROR_API_URL=             https://<render-service>.onrender.com
# MIRROR_API_TOKEN=           same value as the Render service

# --- Runtime ---
RADE_ENV=paper            # paper | demo | live
RADE_LOG_LEVEL=INFO
RADE_DATA_DIR=./data
